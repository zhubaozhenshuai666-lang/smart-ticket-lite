<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zewbby.smartticket.mapper.ShowMapper">

    <resultMap id="ShowListVOResultMap" type="com.zewbby.smartticket.domain.vo.ShowListVO">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="artist" column="artist"/>
        <result property="city" column="city"/>
        <result property="venueName" column="venue_name"/>
        <result property="nearestStartTime" column="nearest_start_time"/>
    </resultMap>

    <resultMap id="ShowDetailVOResultMap" type="com.zewbby.smartticket.domain.vo.ShowDetailVO">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="artist" column="artist"/>
        <result property="description" column="description"/>
        <result property="city" column="city"/>
        <result property="venueName" column="venue_name"/>
        <result property="address" column="address"/>
    </resultMap>

    <resultMap id="SessionVOResultMap" type="com.zewbby.smartticket.domain.vo.SessionVO">
        <id property="id" column="id"/>
        <result property="showId" column="show_id"/>
        <result property="venueId" column="venue_id"/>
        <result property="venueName" column="venue_name"/>
        <result property="city" column="city"/>
        <result property="address" column="address"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
    </resultMap>

    <resultMap id="TicketCategoryVOResultMap" type="com.zewbby.smartticket.domain.vo.TicketCategoryVO">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="name" column="name"/>
        <result property="price" column="price"/>
        <result property="totalStock" column="total_stock"/>
        <result property="availableStock" column="available_stock"/>
    </resultMap>

    <resultMap id="ShowInfoResultMap" type="com.zewbby.smartticket.domain.entity.ShowInfo">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="artist" column="artist"/>
        <result property="venueId" column="venue_id"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="PerformanceSessionResultMap" type="com.zewbby.smartticket.domain.entity.PerformanceSession">
        <id property="id" column="id"/>
        <result property="showId" column="show_id"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectShowList" resultMap="ShowListVOResultMap">
        SELECT
            si.id,
            si.title,
            si.artist,
            v.city,
            v.name AS venue_name,
            MIN(ps.start_time) AS nearest_start_time
        FROM show_info si
        LEFT JOIN performance_session ps ON ps.show_id = si.id AND ps.status = 'PUBLISHED'
        LEFT JOIN venue v ON v.id = si.venue_id
        WHERE si.status = 'PUBLISHED'
        GROUP BY
            si.id,
            si.title,
            si.artist,
            v.city,
            v.name
        ORDER BY nearest_start_time ASC
    </select>

    <select id="selectShowDetailById" parameterType="java.lang.Long" resultMap="ShowDetailVOResultMap">
        SELECT
            si.id,
            si.title,
            si.artist,
            si.description,
            v.city,
            v.name AS venue_name,
            v.address
        FROM show_info si
        LEFT JOIN performance_session ps ON ps.show_id = si.id AND ps.status = 'PUBLISHED'
        LEFT JOIN venue v ON v.id = si.venue_id
        WHERE si.id = #{showId}
          AND si.status = 'PUBLISHED'
        ORDER BY ps.start_time ASC
        LIMIT 1
    </select>

    <select id="selectSessionsByShowId" parameterType="java.lang.Long" resultMap="SessionVOResultMap">
        SELECT
            ps.id,
            ps.show_id,
            v.id AS venue_id,
            v.name AS venue_name,
            v.city,
            v.address,
            ps.start_time,
            ps.end_time
        FROM performance_session ps
        LEFT JOIN show_info si ON si.id = ps.show_id
        LEFT JOIN venue v ON v.id = si.venue_id
        WHERE ps.show_id = #{showId}
          AND ps.status = 'PUBLISHED'
          AND si.status = 'PUBLISHED'
        ORDER BY ps.start_time ASC
    </select>

    <select id="selectTicketCategoriesBySessionId"
            parameterType="java.lang.Long"
            resultMap="TicketCategoryVOResultMap">
        SELECT
            tc.id,
            tc.session_id,
            tc.category_name AS name,
            tc.price,
            ts.total_stock,
            ts.available_stock
        FROM ticket_category tc
        LEFT JOIN ticket_stock ts ON ts.ticket_category_id = tc.id
        WHERE tc.session_id = #{sessionId}
          AND tc.status = 'PUBLISHED'
        ORDER BY tc.price ASC
    </select>

    <select id="adminSelectShows" resultMap="ShowInfoResultMap">
        SELECT
            id,
            title,
            artist,
            venue_id,
            description,
            status,
            created_at,
            updated_at
        FROM show_info
        <where>
            <if test="status != null and status != ''">
                status = #{status}
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

    <select id="selectShowInfoById" parameterType="java.lang.Long" resultMap="ShowInfoResultMap">
        SELECT
            id,
            title,
            artist,
            venue_id,
            description,
            status,
            created_at,
            updated_at
        FROM show_info
        WHERE id = #{id}
    </select>

    <insert id="insertShow"
            parameterType="com.zewbby.smartticket.domain.entity.ShowInfo"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO show_info (
            title,
            artist,
            venue_id,
            description,
            status,
            created_at,
            updated_at
        ) VALUES (
            #{title},
            #{artist},
            #{venueId},
            #{description},
            #{status},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <update id="updateShow">
        UPDATE show_info
        SET
            title = #{title},
            artist = #{artist},
            venue_id = #{venueId},
            description = #{description},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <update id="updateShowStatus">
        UPDATE show_info
        SET
            status = #{status},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <select id="adminSelectSessionsByShowId" parameterType="java.lang.Long" resultMap="PerformanceSessionResultMap">
        SELECT
            id,
            show_id,
            start_time,
            end_time,
            status,
            created_at,
            updated_at
        FROM performance_session
        WHERE show_id = #{showId}
        ORDER BY start_time ASC
    </select>

    <select id="selectSessionById" parameterType="java.lang.Long" resultMap="PerformanceSessionResultMap">
        SELECT
            id,
            show_id,
            start_time,
            end_time,
            status,
            created_at,
            updated_at
        FROM performance_session
        WHERE id = #{id}
    </select>

    <insert id="insertSession"
            parameterType="com.zewbby.smartticket.domain.entity.PerformanceSession"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO performance_session (
            show_id,
            start_time,
            end_time,
            status,
            created_at,
            updated_at
        ) VALUES (
            #{showId},
            #{startTime},
            #{endTime},
            #{status},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <update id="updateSession">
        UPDATE performance_session
        SET
            start_time = #{startTime},
            end_time = #{endTime},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <update id="updateSessionStatus">
        UPDATE performance_session
        SET
            status = #{status},
            updated_at = NOW()
        WHERE id = #{id}
    </update>
</mapper>
