<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zewbby.smartticket.mapper.PaymentFlowLogMapper">

    <insert id="insert"
            parameterType="com.zewbby.smartticket.domain.entity.PaymentFlowLog"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO payment_flow_log (
            payment_no,
            order_id,
            from_status,
            to_status,
            event_type,
            amount,
            result,
            reason,
            created_at
        ) VALUES (
            #{paymentNo},
            #{orderId},
            #{fromStatus},
            #{toStatus},
            #{eventType},
            #{amount},
            #{result},
            #{reason},
            #{createdAt}
        )
    </insert>
</mapper>
