@host = http://localhost:8081
@token = replace-with-login-token
@ticketCategoryId = 2
@recordId = 1

### 1. 登录获取 token
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "phone": "13800000001",
  "password": "Test123456"
}

### 2. 预热指定票档 Redis 库存
POST {{host}}/api/admin/stocks/{{ticketCategoryId}}/preload
Authorization: Bearer {{token}}

### 3. 单票档库存一致性检查
POST {{host}}/api/admin/stocks/consistency/check/{{ticketCategoryId}}
Authorization: Bearer {{token}}

### 4. 全量分页检查
POST {{host}}/api/admin/stocks/consistency/check-all?batchSize=100
Authorization: Bearer {{token}}

### 5. 查询差异记录
GET {{host}}/api/admin/stocks/consistency-records?status=PENDING&limit=20
Authorization: Bearer {{token}}

### 6. 修复差异记录
# 修复会重新计算 expectedRedisAvailable，并使用 Lua CAS + Delta。
POST {{host}}/api/admin/stocks/consistency-records/{{recordId}}/repair
Authorization: Bearer {{token}}

### 7. 忽略差异记录
POST {{host}}/api/admin/stocks/consistency-records/{{recordId}}/ignore
Authorization: Bearer {{token}}

### 8. 补偿 FAILED 异步下单请求的 Redis 预扣
POST {{host}}/api/admin/stocks/failed-requests/compensate?batchSize=100
Authorization: Bearer {{token}}

### 9. MySQL 验证在途预扣量
# SELECT COALESCE(SUM(deducted_quantity), 0) AS in_flight_deducted_quantity
# FROM ticket_order_request
# WHERE ticket_category_id = 2
#   AND status IN ('PRE_DEDUCTED', 'QUEUED', 'PROCESSING')
#   AND redis_deducted = TRUE
#   AND compensated = FALSE
#   AND compensation_status IN ('NONE', 'COMPENSATE_FAILED')
#   AND deducted_quantity > 0;

### 10. MySQL 查看库存差异和补偿审计
# SELECT * FROM stock_consistency_record ORDER BY id DESC LIMIT 20;
# SELECT * FROM stock_compensation_record ORDER BY id DESC LIMIT 20;
